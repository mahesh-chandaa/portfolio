---
import '../styles/global.css';
import data from '../data/resume-data.json';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.name} | Portfolio</title>
    <!-- Using the Tailwind CDN script is the safest way to ensure no more build crashes -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-200 font-sans">
    <main class="max-w-4xl mx-auto px-6 py-20">
        
        <!-- Header -->
        <header class="mb-16">
            <h1 class="text-5xl font-bold text-white mb-4 tracking-tight">{data.name}</h1>
            <p class="text-xl text-blue-400 mb-6 font-mono">{data.title}</p>
            <p class="text-slate-400 max-w-2xl leading-relaxed">{data.summary}</p>
        </header>

        <!-- Stats Section -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
            {data.stats.map(stat => (
                <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl">
                    <p class="text-slate-500 text-sm uppercase tracking-widest mb-2">{stat.label}</p>
                    <p class="text-3xl font-bold text-white">{stat.value}</p>
                </div>
            ))}
        </section>

        <!-- Experience Timeline -->
        <section class="mb-20">
            <h2 class="text-2xl font-bold text-white mb-10 flex items-center">
                <span class="w-8 h-[2px] bg-blue-500 mr-4"></span> Professional Experience
            </h2>
            <div class="space-y-12">
                {data.experience.map(job => (
                    <div class="relative pl-8 border-l border-slate-800">
                        <div class="absolute w-3 h-3 bg-blue-500 rounded-full -left-[6.5px] top-2 shadow-[0_0_10px_#3b82f6]"></div>
                        <h3 class="text-xl font-bold text-white">{job.role}</h3>
                        <p class="text-blue-400 font-mono text-sm mb-4">{job.company} | {job.period}</p>
                        <ul class="space-y-3">
                            {job.highlights.map(point => (
                                <li class="text-slate-400 flex items-start">
                                    <span class="text-blue-500 mr-2">▹</span> {point}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        <!-- Tech Stack -->
        <section>
            <h2 class="text-2xl font-bold text-white mb-10 flex items-center">
                <span class="w-8 h-[2px] bg-blue-500 mr-4"></span> Technical Arsenal
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {Object.entries(data.skills).map(([category, list]) => (
                    <div>
                        <h4 class="text-slate-300 font-bold mb-4 uppercase text-xs tracking-widest">{category}</h4>
                        <div class="flex flex-wrap gap-2">
                            {list.map(skill => (
                                <span class="bg-slate-900 border border-slate-800 px-3 py-1 rounded text-sm text-slate-400">
                                    {skill}
                                </span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

    </main>
</body>
</html>
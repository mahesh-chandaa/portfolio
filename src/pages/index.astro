---
import data from '../data/resume-data.json';
const base = '/portfolio';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.name} | Portfolio</title>
    <style>
        /* SRE STANDARD CSS - NO DEPENDENCIES */
        :root {
            --bg-color: #020617;
            --card-bg: #0f172a;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #3b82f6;
            --border: #1e293b;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
            margin: 0;
            line-height: 1.5;
        }

        main {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 24px;
        }

        header { margin-bottom: 64px; }
        
        h1 { font-size: 3rem; margin: 0 0 16px 0; letter-spacing: -0.025em; }
        
        .role { 
            color: var(--accent); 
            font-family: monospace; 
            font-size: 1.25rem; 
            margin-bottom: 24px; 
        }

        .summary { color: var(--text-muted); max-width: 600px; font-size: 1.1rem; }

        .btn-container { display: flex; gap: 16px; margin-top: 32px; }

        .btn-primary {
            background: var(--accent);
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn-secondary {
            border: 1px solid var(--border);
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-bottom: 80px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 24px;
            border-radius: 16px;
        }

        .stat-label { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
        
        .stat-value { font-size: 1.875rem; font-weight: bold; margin: 0; }

        section h2 {
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            margin-bottom: 40px;
        }

        section h2::before {
            content: "";
            width: 32px;
            height: 2px;
            background: var(--accent);
            margin-right: 16px;
        }

        .experience-item {
            position: relative;
            padding-left: 32px;
            border-left: 1px solid var(--border);
            margin-bottom: 48px;
        }

        .experience-item::after {
            content: "";
            position: absolute;
            left: -5px;
            top: 8px;
            width: 9px;
            height: 9px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
        }

        .skills-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }

        .skill-group {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            padding: 24px;
            border-radius: 12px;
        }

        .skill-tag {
            background: #1e293b;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.875rem;
            margin: 4px;
            display: inline-block;
            color: #cbd5e1;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-color); }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
    </style>
</head>
<body>
    <main>
        <header>
            <h1>{data.name}</h1>
            <div class="role">{data.title}</div>
            <p class="summary">{data.summary}</p>
            
            <div class="btn-container">
                <a href={`mailto:${data.email}`} class="btn-primary">Contact Me</a>
                <a href={`${base}/${data.resumeLink}`} download class="btn-secondary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download Resume
                </a>
            </div>
        </header>

        <div class="stats-grid">
            {data.stats.map(stat => (
                <div class="stat-card">
                    <div class="stat-label">{stat.label}</div>
                    <p class="stat-value">{stat.value}</p>
                </div>
            ))}
        </div>

        <section>
            <h2>Professional Experience</h2>
            {data.experience.map(job => (
                <div class="experience-item">
                    <h3 style="margin:0">{job.role}</h3>
                    <p style="color:var(--accent); font-family:monospace; margin: 4px 0 16px 0">{job.company} | {job.period}</p>
                    <ul style="padding:0; list-style:none; color:var(--text-muted)">
                        {job.highlights.map(point => (
                            <li style="margin-bottom:8px">▹ {point}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </section>

        <section>
            <h2>Technical Skills</h2>
            <div class="skills-grid">
                {Object.entries(data.skills).map(([category, list]) => (
                    <div class="skill-group">
                        <h4 style="margin:0 0 16px 0; font-size:0.75rem; text-transform:uppercase; color:#94a3b8">{category}</h4>
                        {list.map(skill => (
                            <span class="skill-tag">{skill}</span>
                        ))}
                    </div>
                ))}
            </div>
        </section>
    </main>
</body>
</html>
